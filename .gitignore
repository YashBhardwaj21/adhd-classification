# --- 6. Neuroimaging & High-Dimensional Biomedical Data ---
# Raw NIfTI neuroimaging scans
*.nii
*.nii.gz

# Medical imaging DICOM files
*.dcm
*.dicom

# Large tabular & columnar array stores (>100 MiB)
*.parquet
*.feather
*.h5
*.hdf5
*.mat

# Serialized Python binaries & array dumps
*.npy
*.npz
*.pkl
*.pickle
*.joblib

# Local raw / intermediate data staging directories
data/raw/
data/processed/
data/cache/
data/downloads/

# Whitelist data documentation and provenance ledgers
!data/README.md
!data/provenance.md

