# ADHD-200 Research Repository Git Ignore
# Configured for Python, PyTorch/PyG, Jupyter, and neuroimaging exclusions.

# Python build and bytecode artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll

# Packaging and distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, coverage and linting
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
conda-env/

# Jupyter notebook checkpoints and cache
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

# Operating system and editor metadata
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
[Nn]on[Tt]racked/

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.rej
*.patch
*.sublime-project
*.sublime-workspace
*.code-workspace
.agents/
.gemini/
.claude/
.cursor/

# Neuroimaging and binary data exclusions
# Raw NIfTI neuroimaging scans
*.nii
*.nii.gz

# Medical imaging DICOM files
*.dcm
*.dicom

# Large tabular and columnar array stores (>100 MiB)
*.parquet
*.feather
*.h5
*.hdf5
*.mat

# Serialized Python binaries and array dumps
*.npy
*.npz
*.pkl
*.pickle
*.joblib

# Local raw or intermediate data staging directories
data/raw/
data/processed/
data/cache/
data/downloads/

# Whitelist data documentation and provenance ledgers
!data/README.md
!data/provenance.md

# Deep learning model weights and checkpoints
checkpoints/
artifacts/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx

# Experiment tracking and logging
wandb/
runs/
lightning_logs/
*.log

# Temporary and scratch files
scratch/
tmp/
temp/
.cache/
*.tmp
*.temp
.tmp_test_paths/
tests/.tmp_test_paths/
